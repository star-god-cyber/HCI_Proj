# =============================================================================
# CS 435 AI Interview Practice Interface — Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root:
#      cp config/.env.example .env
# 2. Add your private API keys below.
# 3. IMPORTANT: '.env' is listed in '.gitignore' and will NEVER be committed to GitHub.
# =============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Tier Default Model: NVIDIA Nemotron 3.5 Super VL
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Google Gemini API Key (Optional secondary fallback: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
