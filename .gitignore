# =============================================================================
# CS 435 AI Interview Practice Interface — Git Ignore Rules
# Strictly prevents secret credentials, caches, and user data from git tracking
# =============================================================================

# --- Environment & Secret Configuration Files ---
.env
.env.*
!.env.example
*.env
config/.env
config/.env.*
!config/.env.example
config/secrets/
secrets/
*.pem
*.key
*.cert
*.p12

# --- Python Bytecode & Compilation Artifacts ---
__pycache__/
app/__pycache__/
tests/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
app/*.db
app/interview_practice.db

# --- Generated Export Artifacts & Temp Files ---
exports/*.docx
exports/*.pptx
test_exports/
*.log

# --- IDEs, Editors & OS Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
