# =============================================================================
# CS 435 AI Interview Practice Interface — Git Ignore Rules
# Strictly prevents secret credentials, reports, presentations, caches,
# submission archives, large media, and temporary runtime files from git tracking.
# =============================================================================

# --- Environment & Secret Configuration Files ---
.env
.env.*
!.env.example
*.env
config/.env
config/.env.*
!config/.env.example
config/secrets/
secrets/
*.pem
*.key
*.cert
*.p12
*.token
credentials.json
client_secret*.json


# --- Submission Packages & Archives ---
submission_package/
Group_*/
*.zip
*.tar.gz
*.tgz
*.rar

# --- Generated Export Artifacts & Runtime Logs ---
exports/
test_exports/
*.log

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
app/*.db
app/interview_practice.db
interview_practice.db


# --- Python Bytecode & Compilation Artifacts ---
__pycache__/
app/__pycache__/
tests/__pycache__/
config/__pycache__/
scripts/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDEs, Editors & OS Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
