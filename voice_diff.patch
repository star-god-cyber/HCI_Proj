+  [aiTab, audioTab, fbTab].forEach(t => { if (t) t.style.display = "none"; });
+  [aiBtn, audioBtn, fbBtn].forEach(b => { if (b) { b.classList.remove("btn-primary"); b.classList.add("btn-outline"); } });
+
+  if (tabName === "feedback") {
+    if (fbTab) fbTab.style.display = "block";
