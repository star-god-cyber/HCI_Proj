# =============================================================================
# CS 435 AI Interview Practice Interface — Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root:
#      cp .env.example .env      (or copy .env.example .env on Windows)
# 2. Add your private API keys below.
# 3. IMPORTANT: '.env' is listed in '.gitignore' and will NEVER be committed to GitHub.
# =============================================================================

# OpenRouter API Key
# 1. Sign up / log in at https://openrouter.ai/
# 2. Generate an API key at https://openrouter.ai/keys
# 3. Paste your key after the '=' below:
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Tier Default Model: NVIDIA Nemotron 3.5 Super VL
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Google Gemini API Key (Optional secondary fallback)
# 1. Generate an API key at https://aistudio.google.com/app/apikey
# 2. Paste your key after the '=' below:
GEMINI_API_KEY=your_gemini_api_key_here
